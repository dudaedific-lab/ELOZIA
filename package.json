{
  "name": "elozia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-env-proxy --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "db:prepare": "node --use-env-proxy --env-file-if-exists=.env server/prepare.mjs"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
